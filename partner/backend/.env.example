# Partner API settings (technical-architecture.md 5.5; app/core/config.py).
# Placeholders only: never put a real value in this file. Copy it to .env and fill in local values.
# R4c part 1 (identity) settings; bookings, dispatch, media and weather settings come with part 2.

APP_NAME=Partner API
# development, test, staging or production (required)
ENVIRONMENT=development
DEBUG=false

# ---- Database ----
DATABASE_URL=postgresql+psycopg://crewnbuild_partner:change-me@localhost:5432/crewnbuild
DATABASE_SCHEMA=partner
# Where Professional publishes the requester view Partner reads (v_partner_requesters).
PROFESSIONAL_SCHEMA=professional

# ---- Sessions ----
# At least 64 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-generate-64-random-bytes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
SESSION_IDLE_DAYS=30
REQUESTER_SESSION_MINUTES=60
REFRESH_REUSE_GRACE_SECONDS=10
# Secure cookies (__Host-par_*); false only for plain-http LAN testing (par_*).
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
FRONTEND_ORIGIN=http://localhost:5373

# ---- Book Technician hand-off from Professional ----
# ES256 (P-256) public key, PEM (one line with \n), matching Professional's PARTNER_HANDOFF_PRIVATE_KEY.
PROFESSIONAL_HANDOFF_PUBLIC_KEY=change-me
HANDOFF_MAX_SECONDS=60

# ---- Technician sign-in throttle ----
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES_PER_EMAIL=10
LOGIN_MAX_FAILURES_PER_CLIENT=50

# ---- E-mail codes ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=change-me
SMTP_FROM_NAME=CREWNBUILD
SMTP_USE_TLS=true
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5
PASSWORD_RESET_TOKEN_MINUTES=10

# ---- Local time ----
LOCAL_TIMEZONE=Asia/Kolkata
LOCAL_UTC_OFFSET_MINUTES=330

# ---- Onboarding: identity data ----
# Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# Encrypts Aadhaar numbers, face captures, bank details and job photos; required in production.
DATA_ENCRYPTION_KEY=change-me
# Stored beside every ciphertext. To rotate: new key, higher version, old key moved below.
DATA_ENCRYPTION_KEY_VERSION=1
# Earlier keys that still decrypt what they wrote: version:key,version:key
DATA_ENCRYPTION_PREVIOUS_KEYS=
FACE_CAPTURE_DIRECTORY=private/face_captures
FACE_CAPTURE_RETENTION_DAYS=7
REQUIRE_VERIFIED_IDENTITY_FOR_JOBS=false
PINCODE_DIRECTORY_URL=https://api.postalpincode.in/pincode

# ---- Earnings ----
# Platform commission in percent of a completed job's price (0-100, two decimals).
# Placeholder, not a decided rate.
PARTNER_COMMISSION_RATE_PERCENT=10

# ---- Bookings, dispatch and live tracking ----
# Job photos: encrypted with DATA_ENCRYPTION_KEY, private directory (never public uploads).
JOB_MEDIA_DIRECTORY=private/job_media
# The dispatch sweeper (offer timeouts, re-offers) runs inside the API process.
DISPATCH_WORKER_ENABLED=true
DISPATCH_OFFER_TIMEOUT_SECONDS=30
DISPATCH_BATCH_SIZE=3
MAX_DISPATCH_ATTEMPTS=3
# none or osrm (road ETAs for ranking)
DISPATCH_ETA_PROVIDER=none
LOCATION_UPDATE_INTERVAL_SECONDS=3
LOCATION_STALE_THRESHOLD_SECONDS=15
# Websocket messages between API processes go through PostgreSQL LISTEN/NOTIFY.
REALTIME_CROSS_PROCESS=true
REALTIME_CHANNEL=partner_realtime
# An open websocket re-checks its session this often.
WEBSOCKET_SESSION_RECHECK_SECONDS=30
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=CREWNBUILD-Partner/1.0
OSRM_BASE_URL=https://router.project-osrm.org

# ---- Weather (Open-Meteo; the keyless endpoint is for non-commercial use) ----
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com/v1
WEATHER_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1
WEATHER_CACHE_MINUTES=25
