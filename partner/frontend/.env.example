# Partner web app settings (technical-architecture.md 5.5, CF-05).
# Every VITE_* value is public once built: URLs, origins and map tiles only, never a secret.
# Copy to .env.local for local development.

VITE_API_BASE_URL=http://localhost:8200/api/v1
# Professional web origin(s) allowed to send the Book Technician hand-off (comma-separated).
VITE_PROFESSIONAL_ORIGIN=http://localhost:5173
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
# "latitude,longitude" shown before a location is known; empty means no default centre.
VITE_MAP_DEFAULT_CENTER=
