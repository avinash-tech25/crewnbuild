# Professional API settings (technical-architecture.md 5.4).
# Placeholders only: never put a real value in this file. Copy it to .env and fill in local values.
# The full list of settings is completed when the application code is copied in (step R4).

# ---- App ----
APP_NAME=CREWNBUILD API
ENVIRONMENT=development
DEBUG=false

# ---- Database (crewnbuild / schema professional) ----
DATABASE_URL=postgresql+psycopg://crewnbuild_professional:change-me@localhost:5432/crewnbuild
DATABASE_SCHEMA=professional

# ---- Sessions ----
JWT_SECRET_KEY=change-me-generate-64-random-bytes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173

# ---- Partner hand-off (Ed25519 private key, PEM, one line with \n) ----
PARTNER_HANDOFF_PRIVATE_KEY=change-me
PARTNER_HANDOFF_SECONDS=60

# ---- Integrations ----
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=change-me
RAZORPAY_KEY_SECRET=change-me
RAZORPAY_WEBHOOK_SECRET=change-me
RAZORPAY_ALLOW_MOCK=true
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
MICROSOFT_CLIENT_ID=change-me
MICROSOFT_CLIENT_SECRET=change-me
WHATSAPP_ENABLED=false
WHATSAPP_API_KEY=change-me
SMTP_HOST=localhost
SMTP_PASSWORD=change-me
OPENAI_API_KEY=change-me
CAMERA_CREDENTIALS_KEY=change-me

# ---- Seeded accounts (app/seeds/) ----
# Global Super Admin: seeded in every environment by seed_admin_accounts.py.
# It signs in only with a WhatsApp code to this number (10-digit Indian mobile, +91 implied); it has no password.
GLOBAL_ADMIN_PHONE=change-me

# Fixed-code WhatsApp test sign-in (seed_test_accounts.py). Works only when TEST_OTP_LOGIN_ENABLED=true
# and ENVIRONMENT is development, test or staging. The service refuses to start in production if it is true.
TEST_OTP_LOGIN_ENABLED=false
TEST_OWNER_OTP_CODE=change-me
TEST_BUILDER_OTP_CODE=change-me
TEST_ADMIN_OTP_CODE=change-me
